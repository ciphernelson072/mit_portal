# Copy to .env.cloudflare-tidb. Keep that file private and never commit it.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://YOUR_TIDB_HOST:4000/mit_student_portal?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USER=YOUR_CLUSTER_PREFIX.sis_app
DB_PASSWORD=replace-with-your-TiDB-password
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Leave blank to keep Flutterwave unavailable. Use test credentials before live credentials.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FRONTEND_URL=https://portal.example.edu
CORS_ALLOWED_ORIGINS=https://portal.example.edu
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
SERVER_PORT=8080
UPLOAD_DIR=./uploads
SAMPLE_DATA_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=false
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MIT Portal
MFA_ENABLED=false
MFA_ENCRYPTION_KEY=
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
AUTH_TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
AUTH_TRUST_X_FORWARDED_FOR=true
