# Copy to .env for local Docker use. Never commit the populated .env file.
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
MYSQL_PORT=3306
UPLOADS_HOST_DIR=./uploads
BACKUPS_HOST_DIR=./backups
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
# Replace with a private, random secret of at least 32 characters.
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Leave blank to keep Flutterwave unavailable. Use test keys before live keys.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Mail is disabled by default. Configure credentials in your private .env file.
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
# For Resend, set MAIL_PROVIDER=resend and configure these in your private .env.
MAIL_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MIT Portal
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_ENABLE=false
# Direct Windows runs default this to backups\.backup-success after creating a
# real dump. Docker reads markers from its read-only /app/backups mount.
BACKUP_STATUS_FILE=
UPLOAD_BACKUP_STATUS_FILE=./backups/.uploads-backup-success
# Enable MFA enrollment with a persistent, private 32-byte Base64 key.
# Enable privileged-account enforcement only after enrollment and recovery checks.
MFA_ENABLED=false
MFA_REQUIRED_FOR_PRIVILEGED=false
MFA_ENCRYPTION_KEY=
# Set true only for a local demo deployment. Keep false in production.
SAMPLE_DATA_ENABLED=false