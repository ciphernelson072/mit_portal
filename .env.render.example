# Safe starting point for the Render Blueprint; replace every REPLACE_WITH value.
# Keep actual credentials and generated secrets in Render's secret environment fields.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=0.0.0.0
UPLOAD_DIR=/var/data/uploads
DB_URL=jdbc:mysql://REPLACE_WITH_MYSQL_HOST:3306/REPLACE_WITH_DATABASE?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USER=REPLACE_WITH_LEAST_PRIVILEGE_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
FRONTEND_URL=https://REPLACE_WITH_RENDER_SERVICE.onrender.com
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_RENDER_SERVICE.onrender.com
MAIL_ENABLED=false
COOKIE_SECURE=true
AUTH_TRUST_X_FORWARDED_FOR=true
COOKIE_SAME_SITE=Strict
FLYWAY_BASELINE_ON_MIGRATE=false
SAMPLE_DATA_ENABLED=false
MFA_ENABLED=false
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false
