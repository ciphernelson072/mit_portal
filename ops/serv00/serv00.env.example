# Copy to ~/.config/mit-portal/serv00.env on the Serv00 account, then chmod 600.
# Replace every placeholder; never commit the populated file.
export SPRING_PROFILES_ACTIVE='prod'
export SERVER_ADDRESS='127.0.0.1'
export SERVER_PORT='REPLACE_WITH_RESERVED_TCP_PORT'
export JAVA_BIN='java17'
export JAVA_OPTS='-Xms96m -Xmx384m -XX:MaxMetaspaceSize=192m'

# Serv00 MySQL host varies by server number: mysql0.serv00.com, mysql1.serv00.com, etc.
export DB_URL='jdbc:mysql://mysqlX.serv00.com:3306/REPLACE_WITH_DATABASE?serverTimezone=UTC'
export DB_USER='REPLACE_WITH_DATABASE_USER'
export DB_PASSWORD='REPLACE_WITH_DATABASE_PASSWORD'

export JWT_SECRET='REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS'
export PAYMENT_WEBHOOK_SECRET='REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS'
# Leave both blank to keep Flutterwave disabled; use test credentials first.
export FLUTTERWAVE_SECRET_KEY=''
export FLUTTERWAVE_WEBHOOK_SECRET_HASH=''
export FRONTEND_URL='https://REPLACE_WITH_YOUR_DOMAIN'
export CORS_ALLOWED_ORIGINS='https://REPLACE_WITH_YOUR_DOMAIN'
export UPLOAD_DIR='/usr/home/REPLACE_WITH_LOGIN/mit-portal-data/uploads'

export COOKIE_SECURE='true'
export COOKIE_SAME_SITE='Strict'
export SAMPLE_DATA_ENABLED='false'
export FLYWAY_BASELINE_ON_MIGRATE='false'
export MAIL_ENABLED='false'
export MFA_ENABLED='false'
export MFA_REQUIRED_FOR_PRIVILEGED='false'
export INITIAL_ADMIN_BOOTSTRAP_ENABLED='false'
export AUTH_TRUSTED_PROXY_IPS='127.0.0.1,::1,::ffff:127.0.0.1'
export AUTH_TRUST_X_FORWARDED_FOR='true'
